# Internal — never publish. Working notes, not deliverables: session handoffs,
# the onboarding brief, and the verbatim problem statement with its running
# submission checklist. Local copies are kept in _internal/docs/.
_internal/
docs/STRATEGY.md
HANDOFF.md
CONTEXT.md
docs/BRIEF.md

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Data artefacts
data/warehouse/*.duckdb
data/raw/*.parquet
data/raw/*.csv
!data/raw/.gitkeep

# GROUND TRUTH — engine must never read this; kept out of the package entirely.
# The `**` matters: each industry keeps its labels in its own subdirectory, and
# a top-level-only pattern would have committed two of the three.
data/ground_truth/**/*.json
!data/ground_truth/.gitkeep

# Secrets
.env
.env.*
!.env.example

# Frontend
ui/node_modules/
ui/dist/

# OS / editor
.DS_Store
.idea/
.vscode/

# Runtime feedback records. Real corrections belong to a deployment, not to
# the repository, and a checked-in file would seed every clone with one
# team’s opinions.
data/feedback/

# Local dev-server config for the preview pane. Machine-specific.
.claude/launch.json
dist/
data/llm_cache/
