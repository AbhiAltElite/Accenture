# Copy to .env. Nothing here is required: with no backend reachable the engine
# runs its deterministic path, and the run receipt reports zero model calls
# rather than the two the design intends.

# --- Model backend --------------------------------------------------------
# ollama (default, local, no account) | openai (any compatible endpoint) | none
WHYCHAIN_LLM_BACKEND=ollama

# Apache 2.0, unrestricted commercial use, no user ceiling. qwen2.5:7b-instruct
# is the same licence and a drop-in alternative. Llama is not the default: its
# community licence caps commercial use at 700M MAU and fails the Open Source
# Definition, which makes it a poor template for client delivery.
WHYCHAIN_LLM_MODEL=mistral:7b-instruct

# Only for the hosted path. Groq, Together, OpenRouter, vLLM and LM Studio all
# serve the same open weights behind this API.
#   WHYCHAIN_LLM_BACKEND=openai
#   WHYCHAIN_LLM_BASE_URL=https://api.groq.com/openai/v1
#   WHYCHAIN_LLM_API_KEY=
#   WHYCHAIN_LLM_MODEL=mistral-7b-instruct

# Per-stage overrides, if the two jobs want different models. Extraction is
# classification and runs well on a small model; the narrative is the harder of
# the two.
# WHYCHAIN_EXTRACTION_MODEL=
# WHYCHAIN_NARRATIVE_MODEL=

WHYCHAIN_DB_PATH=data/warehouse/whychain.duckdb
